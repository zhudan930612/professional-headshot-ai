# Source-only configuration for one-time export / legacy checks.
# The deployed Cloudflare site does not use these Supabase variables.
# Runtime configuration: .dev.vars.example and wrangler.toml.
VITE_SUPABASE_URL=https://your-source-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_source_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_source_admin_key

# Optional one-time configure-pages helper inputs (never bundled).
VITE_GOOGLE_CLIENT_ID=your_existing_google_client_id.apps.googleusercontent.com
CREEM_API_KEY=your_creem_key
CREEM_WEBHOOK_SECRET=your_creem_webhook_secret
CREEM_PROFESSIONAL_PRODUCT_ID=your_professional_product_id
CREEM_EXECUTIVE_PRODUCT_ID=your_executive_product_id
NANO_BANANA_API_KEY=your_evolink_key
