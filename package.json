{
  "name": "professional-headshot-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr prerender/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts && pnpm build:worker",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:prerender": "tsx scripts/check-prerender.ts",
    "check:hydration": "vitest run --config vitest.hydration.config.ts",
    "build:functions": "pnpm build:worker",
    "dev:full": "pnpm build && wrangler pages dev dist --port 3000 --env-file .dev.vars",
    "check:payments": "tsx scripts/check-payments.ts",
    "check:recovery": "pnpm check:cloudflare",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:auth": "pnpm check:cloudflare",
    "check:supabase": "tsx scripts/check-supabase.ts",
    "build:worker": "esbuild cloudflare/worker.ts --bundle --format=esm --platform=browser --target=es2022 --conditions=workerd --outfile=dist/_worker.js",
    "check:cloudflare": "tsx scripts/cloudflare/check-runtime.ts",
    "check:source": "tsx scripts/check-supabase.ts",
    "export:source": "tsx scripts/cloudflare/export-source.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm check:prerender && pnpm check:hydration && pnpm exec tsx scripts/cloudflare/verify-artifact.ts && pnpm check:secrets && pnpm audit"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@supabase/supabase-js": "^2.117.3",
    "buffer": "^6.0.3",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "jose": "^6.2.15",
    "lucide-react": "^0.556.0",
    "marked": "^15.0.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@electric-sql/pglite": "^0.5.8",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "jsdom": "26.1.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.3",
    "wrangler": "4.156.1"
  },
  "pnpm": {
    "overrides": {
      "postcss-selector-parser@6.1.4": "6.1.5"
    }
  }
}
